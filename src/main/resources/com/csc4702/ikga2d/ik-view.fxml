<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.csc4702.ikga2d.IKController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <HBox alignment="CENTER" spacing="8.0">
        <Label text="Target X:"/>
        <TextField fx:id="targetXField" text="1.2" prefColumnCount="5"/>
        <Label text="Y:"/>
        <TextField fx:id="targetYField" text="0.8" prefColumnCount="5"/>
        <Button text="Run GA" onAction="#onRun" defaultButton="true"/>
    </HBox>

    <Canvas fx:id="canvas" width="400.0" height="400.0"/>
    <Label fx:id="resultLabel" wrapText="true" prefWidth="400.0" minHeight="90.0" prefHeight="90.0" alignment="TOP_LEFT"
           text="Enter a target and press Run GA."/>
</VBox>
